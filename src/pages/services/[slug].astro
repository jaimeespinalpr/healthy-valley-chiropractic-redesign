---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { contact, services } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
const otherServices = services.filter((s) => s.slug !== service.slug);
---

<BaseLayout
  title={`${service.title} | Healthy Valley Chiropractic`}
  description={service.intro}
  image={service.image}
>
  <!-- ===== Page hero ===== -->
  <section class="relative overflow-hidden pb-16 pt-36 sm:pb-20 sm:pt-44">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[30rem] w-[30rem] rounded-full bg-mint-100 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-40 top-40 h-[24rem] w-[24rem] rounded-full bg-leaf-100 blur-3xl"></div>
    <div class="shell-wide relative">
      <nav class="text-xs font-extrabold uppercase tracking-[0.24em] text-brand-400" aria-label="Breadcrumb" data-reveal>
        <a href={base} class="hover:text-brand-700">Home</a>
        <span class="mx-2 text-brand-300">/</span>
        <a href={`${base}#services`} class="hover:text-brand-700">Services</a>
        <span class="mx-2 text-brand-300">/</span>
        <span class="text-brand-700">{service.title}</span>
      </nav>
      <h1 class="display mt-6 max-w-3xl text-5xl leading-[1.04] text-brand-950 sm:text-6xl" data-reveal style="--reveal-delay: 80ms">
        {service.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-brand-800/80" data-reveal style="--reveal-delay: 160ms">
        {service.intro}
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 240ms">
        <a href={contact.schedulingLink} target="_blank" rel="noreferrer" class="button button-primary">
          Schedule an appointment
        </a>
        <a href={contact.phoneHref} class="button button-ghost">Call {contact.phone}</a>
      </div>
    </div>
  </section>

  <!-- ===== Body ===== -->
  <section class="section bg-white !pt-16">
    <div class="shell-wide grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <figure class="overflow-hidden rounded-[2.5rem] shadow-[0_30px_80px_rgba(17,31,48,0.18)] lg:sticky lg:top-28" data-reveal>
        <img src={asset(service.image)} alt={service.title} class="h-full max-h-[34rem] w-full object-cover" />
      </figure>

      <div data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow">About this service</p>
        <div class="mt-6 space-y-5">
          {service.paragraphs.map((paragraph) => (
            <p class="text-base leading-8 text-brand-800/80 sm:text-lg">{paragraph}</p>
          ))}
        </div>

        <div class="mt-10 rounded-[2rem] border border-brand-900/8 bg-brand-50 p-7 sm:p-8">
          <h2 class="display text-2xl text-brand-950">How it can help</h2>
          <ul class="mt-5 space-y-3.5">
            {service.helps.map((item) => (
              <li class="flex items-start gap-3 text-base leading-7 text-brand-800/85">
                <svg class="mt-1 h-5 w-5 shrink-0 text-leaf-600" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.86-9.83a.75.75 0 00-1.22-.87l-2.96 4.14-1.5-1.5a.75.75 0 10-1.06 1.06l2.12 2.12a.75.75 0 001.14-.09l3.48-4.86z" clip-rule="evenodd" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <p class="mt-8 text-sm leading-7 text-brand-800/55">
          Wondering if this is the right fit for you? Call the office at
          <a href={contact.phoneHref} class="font-bold text-brand-700 hover:text-brand-900">{contact.phone}</a>
          — a short conversation is the easiest way to find out.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Other services ===== -->
  <section class="section">
    <div class="shell-wide">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow">Keep exploring</p>
        <h2 class="section-title">More ways we can help</h2>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {otherServices.map((other, index) => (
          <a
            href={`${base}services/${other.slug}/`}
            class="group rounded-[1.6rem] border border-brand-900/8 bg-white p-6 shadow-[0_14px_36px_rgba(17,31,48,0.06)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_22px_50px_rgba(17,31,48,0.12)]"
            data-reveal
            style={`--reveal-delay: ${(index % 3) * 80}ms`}
          >
            <h3 class="display text-xl text-brand-950 transition group-hover:text-brand-700">{other.title}</h3>
            <p class="mt-2 text-sm leading-6 text-brand-800/65">{other.description}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-extrabold text-leaf-600">
              Learn more
              <svg class="h-4 w-4 transition duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 10h12m0 0l-5-5m5 5l-5 5" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
