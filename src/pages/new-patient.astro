---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { contact } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="New Patient Form | Healthy Valley Chiropractic"
  description="Schedule your first appointment at Healthy Valley Chiropractic. Fill out our new patient form and we'll be in touch to confirm your visit."
>
  <!-- ===== Page hero ===== -->
  <section class="relative overflow-hidden pb-16 pt-36 sm:pb-20 sm:pt-44">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[30rem] w-[30rem] rounded-full bg-leaf-100 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-40 top-40 h-[24rem] w-[24rem] rounded-full bg-mint-100 blur-3xl"></div>
    <div class="shell-wide relative">
      <nav class="text-xs font-extrabold uppercase tracking-[0.24em] text-brand-400" aria-label="Breadcrumb" data-reveal>
        <a href={base} class="hover:text-brand-700">Home</a>
        <span class="mx-2 text-brand-300">/</span>
        <span class="text-brand-700">New Patient Form</span>
      </nav>
      <h1 class="display mt-6 max-w-3xl text-5xl leading-[1.04] text-brand-950 sm:text-6xl" data-reveal style="--reveal-delay: 80ms">
        Welcome to our practice
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-brand-800/80" data-reveal style="--reveal-delay: 160ms">
        Fill out the form below to schedule your first visit. A member of our team will reach out to confirm your appointment and discuss the new patient special offer.
      </p>
    </div>
  </section>

  <!-- ===== Form section ===== -->
  <section class="section bg-white !pt-16">
    <div class="shell-wide grid items-start gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div data-reveal>
        <h2 class="display text-3xl text-brand-950">Let's get started</h2>
        <p class="mt-4 text-base leading-8 text-brand-800/75">
          We're excited to meet you. This brief form helps us understand your needs and prepare for your first visit. It should take just a few minutes.
        </p>

        <div class="mt-10 space-y-6">
          <div class="flex gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-leaf-500 text-brand-950 font-bold">
              1
            </div>
            <div>
              <h3 class="font-bold text-brand-950">Tell us about yourself</h3>
              <p class="mt-1 text-sm text-brand-800/70">Basic contact information and health history</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-leaf-500 text-brand-950 font-bold">
              2
            </div>
            <div>
              <h3 class="font-bold text-brand-950">Share your concerns</h3>
              <p class="mt-1 text-sm text-brand-800/70">Let us know what brought you in and what you'd like to address</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-leaf-500 text-brand-950 font-bold">
              3
            </div>
            <div>
              <h3 class="font-bold text-brand-950">Pick a time</h3>
              <p class="mt-1 text-sm text-brand-800/70">Let us know when you'd prefer to visit</p>
            </div>
          </div>
        </div>

        <div class="mt-12 rounded-[1.5rem] border border-brand-900/8 bg-brand-50 p-6">
          <p class="text-sm text-brand-800/75">
            <span class="font-bold text-brand-950">Prefer to call?</span> We're happy to chat by phone and answer any questions before you visit.
          </p>
          <a href={contact.phoneHref} class="mt-3 inline-block font-bold text-brand-700 hover:text-brand-900">
            Call {contact.phone}
          </a>
        </div>
      </div>

      <!-- Form -->
      <form
        method="POST"
        action="https://formsubmit.co/jaimeespinalpr@gmail.com"
        class="rounded-[2rem] border border-brand-900/8 bg-white p-8 shadow-[0_20px_50px_rgba(17,31,48,0.08)] sm:p-10"
        data-reveal
        style="--reveal-delay: 100ms"
      >
        <!-- Name -->
        <div class="mb-6">
          <label for="name" class="block text-sm font-bold text-brand-950 mb-2">
            Full Name <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full rounded-lg border border-brand-900/15 bg-white px-4 py-3 text-brand-950 placeholder:text-brand-800/40 focus:border-brand-700 focus:outline-none focus:ring-1 focus:ring-brand-700 transition"
            placeholder="John Smith"
          />
        </div>

        <!-- Email -->
        <div class="mb-6">
          <label for="email" class="block text-sm font-bold text-brand-950 mb-2">
            Email <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full rounded-lg border border-brand-900/15 bg-white px-4 py-3 text-brand-950 placeholder:text-brand-800/40 focus:border-brand-700 focus:outline-none focus:ring-1 focus:ring-brand-700 transition"
            placeholder="john@example.com"
          />
        </div>

        <!-- Phone -->
        <div class="mb-6">
          <label for="phone" class="block text-sm font-bold text-brand-950 mb-2">
            Phone <span class="text-red-500">*</span>
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            class="w-full rounded-lg border border-brand-900/15 bg-white px-4 py-3 text-brand-950 placeholder:text-brand-800/40 focus:border-brand-700 focus:outline-none focus:ring-1 focus:ring-brand-700 transition"
            placeholder="(814) 123-4567"
          />
        </div>

        <!-- Chief Complaint -->
        <div class="mb-6">
          <label for="complaint" class="block text-sm font-bold text-brand-950 mb-2">
            What brings you in? <span class="text-red-500">*</span>
          </label>
          <select
            id="complaint"
            name="complaint"
            required
            class="w-full rounded-lg border border-brand-900/15 bg-white px-4 py-3 text-brand-950 focus:border-brand-700 focus:outline-none focus:ring-1 focus:ring-brand-700 transition"
          >
            <option value="">Select a concern</option>
            <option value="back-pain">Back pain</option>
            <option value="neck-pain">Neck pain</option>
            <option value="headaches">Headaches</option>
            <option value="sports-injury">Sports injury</option>
            <option value="auto-accident">Auto accident</option>
            <option value="pregnancy-care">Pregnancy care</option>
            <option value="pediatric">Child/pediatric care</option>
            <option value="wellness">Wellness and prevention</option>
            <option value="other">Other</option>
          </select>
        </div>

        <!-- Additional Details -->
        <div class="mb-6">
          <label for="details" class="block text-sm font-bold text-brand-950 mb-2">
            Tell us more (optional)
          </label>
          <textarea
            id="details"
            name="details"
            rows="4"
            class="w-full rounded-lg border border-brand-900/15 bg-white px-4 py-3 text-brand-950 placeholder:text-brand-800/40 focus:border-brand-700 focus:outline-none focus:ring-1 focus:ring-brand-700 transition resize-none"
            placeholder="Any additional information that would help us prepare for your visit..."
          ></textarea>
        </div>

        <!-- Preferred Day -->
        <div class="mb-6">
          <label for="preferred-day" class="block text-sm font-bold text-brand-950 mb-2">
            Preferred day of week
          </label>
          <select
            id="preferred-day"
            name="preferred-day"
            class="w-full rounded-lg border border-brand-900/15 bg-white px-4 py-3 text-brand-950 focus:border-brand-700 focus:outline-none focus:ring-1 focus:ring-brand-700 transition"
          >
            <option value="">No preference</option>
            <option value="monday">Monday</option>
            <option value="tuesday">Tuesday</option>
            <option value="wednesday">Wednesday</option>
            <option value="thursday">Thursday</option>
            <option value="friday">Friday</option>
            <option value="saturday">Saturday</option>
          </select>
        </div>

        <!-- Preferred Time -->
        <div class="mb-6">
          <label for="preferred-time" class="block text-sm font-bold text-brand-950 mb-2">
            Preferred time
          </label>
          <select
            id="preferred-time"
            name="preferred-time"
            class="w-full rounded-lg border border-brand-900/15 bg-white px-4 py-3 text-brand-950 focus:border-brand-700 focus:outline-none focus:ring-1 focus:ring-brand-700 transition"
          >
            <option value="">No preference</option>
            <option value="morning">Morning (8am-12pm)</option>
            <option value="afternoon">Afternoon (12pm-5pm)</option>
            <option value="evening">Evening (5pm+)</option>
          </select>
        </div>

        <!-- Consent -->
        <div class="mb-8">
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="consent"
              required
              class="mt-1 h-5 w-5 rounded border border-brand-900/15 accent-leaf-500 focus:ring-1 focus:ring-brand-700"
            />
            <span class="text-sm text-brand-800/75">
              I consent to be contacted by Healthy Valley Chiropractic to confirm my appointment and discuss the new patient special offer.
            </span>
          </label>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="button button-accent w-full"
        >
          Submit Form
        </button>

        <p class="mt-4 text-xs text-brand-800/60 text-center">
          We'll reach out within 24 hours to confirm your appointment.
        </p>
      </form>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <CtaBand />
</BaseLayout>

<style>
  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
  }
</style>
