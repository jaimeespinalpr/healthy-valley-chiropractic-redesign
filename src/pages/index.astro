---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  contact,
  galleryItems,
  marqueeItems,
  officeHours,
  pillars,
  quote,
  reviewStats,
  services,
  testimonials,
  visitSteps,
} from '../data/site';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<BaseLayout
  title="Healthy Valley Chiropractic | State College, PA"
  description="Healthy Valley Chiropractic blends hands-on corrective care, wellness care, and family-friendly chiropractic in downtown State College, Pennsylvania."
>
  <!-- ===== Hero ===== -->
  <section class="relative flex items-center overflow-hidden lg:min-h-[100svh]">
    <div class="pointer-events-none absolute -right-48 -top-48 h-[36rem] w-[36rem] rounded-full bg-mint-100 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-48 bottom-0 h-[28rem] w-[28rem] rounded-full bg-leaf-100 blur-3xl"></div>

    <div class="shell-wide relative z-10 grid items-center gap-14 pb-20 pt-32 sm:pt-40 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:pb-28">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal>State College, Pennsylvania</p>
        <h1 class="display mt-5 text-5xl leading-[1.02] text-brand-950 sm:text-6xl lg:text-7xl" data-reveal style="--reveal-delay: 80ms">
          Chiropractic care for every stage of life
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-brand-800/80" data-reveal style="--reveal-delay: 160ms">
          From corrective care and spinal decompression to family wellness, Healthy Valley Chiropractic pairs
          hands-on treatment with a calm, welcoming experience — right in downtown State College.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 240ms">
          <a href={contact.schedulingLink} target="_blank" rel="noreferrer" class="button button-primary">
            Schedule an appointment
          </a>
          <a href={`${base}special/`} class="button button-accent">New patient special</a>
          <a href={contact.phoneHref} class="button button-ghost">Call {contact.phone}</a>
        </div>

        <div class="mt-12 flex flex-wrap gap-2.5" data-reveal style="--reveal-delay: 320ms">
          <span class="chip">
            <svg class="h-3.5 w-3.5 text-leaf-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .27.14.52.37.65l3.5 2a.75.75 0 10.76-1.3L10.75 9.6V5z" clip-rule="evenodd"/></svg>
            Open Mon – Fri
          </span>
          <span class="chip">
            <svg class="h-3.5 w-3.5 text-leaf-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.7 17.7a.75.75 0 00.6 0c.1-.05 5.95-2.77 5.95-8.45A6.25 6.25 0 0010 3a6.25 6.25 0 00-6.25 6.25c0 5.68 5.84 8.4 5.95 8.44zM10 11.5a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd"/></svg>
            {contact.addressLine1}
          </span>
          <span class="chip">
            <svg class="h-3.5 w-3.5 text-leaf-600" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.86-9.83a.75.75 0 00-1.22-.87l-2.96 4.14-1.5-1.5a.75.75 0 10-1.06 1.06l2.12 2.12a.75.75 0 001.14-.09l3.48-4.86z" clip-rule="evenodd"/></svg>
            Family-friendly care
          </span>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-lg lg:justify-self-end" data-reveal style="--reveal-delay: 200ms">
        <div class="absolute -left-7 -top-7 h-44 w-44 rounded-[2.5rem] bg-leaf-300/50"></div>
        <div class="absolute -bottom-9 -right-7 h-52 w-52 rounded-full bg-mint-300/45"></div>
        <figure class="relative overflow-hidden rounded-[2.5rem] shadow-[0_36px_90px_rgba(17,31,48,0.24)]">
          <img
            src={asset('/images/corrective-care.jpg')}
            alt="Hands-on chiropractic care at Healthy Valley Chiropractic"
            class="aspect-[4/5] w-full object-cover"
            fetchpriority="high"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-950/45 via-transparent to-transparent"></div>
          <figcaption class="absolute inset-x-0 bottom-0 p-6">
            <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.3em] text-leaf-400">Healthy Valley Chiropractic</p>
            <p class="display mt-1.5 text-xl text-white">Hands-on care, explained clearly</p>
          </figcaption>
        </figure>
        <div class="absolute -left-5 top-8 hidden rounded-2xl bg-white px-5 py-4 shadow-[0_20px_50px_rgba(17,31,48,0.18)] sm:block">
          <p class="text-[0.6rem] font-extrabold uppercase tracking-[0.26em] text-brand-500">Downtown</p>
          <p class="display mt-0.5 text-base text-brand-950">State College, PA</p>
        </div>
        <div class="absolute -right-4 bottom-14 hidden rounded-2xl bg-brand-950 px-5 py-4 shadow-[0_20px_50px_rgba(17,31,48,0.3)] sm:block">
          <p class="text-[0.6rem] font-extrabold uppercase tracking-[0.26em] text-leaf-400">Call today</p>
          <a href={contact.phoneHref} class="display mt-0.5 block text-base text-white hover:text-leaf-300">{contact.phone}</a>
        </div>
      </div>
    </div>

    <a
      href="#experience"
      class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.65rem] font-extrabold uppercase tracking-[0.3em] text-brand-800/60 hover:text-brand-900 lg:flex"
      aria-label="Scroll to explore"
    >
      Explore
      <svg class="h-4 w-4 animate-bounce" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v10.64l3.72-3.72a.75.75 0 111.06 1.06l-5 5a.75.75 0 01-1.06 0l-5-5a.75.75 0 111.06-1.06l3.72 3.72V3.75A.75.75 0 0110 3z" clip-rule="evenodd"/></svg>
    </a>
  </section>

  <!-- ===== Marquee ===== -->
  <section class="bg-brand-950 py-6" aria-label="Conditions and services we help with">
    <div class="marquee">
      {[0, 1].map((i) => (
        <div class="marquee-track" aria-hidden={i === 1 ? 'true' : undefined}>
          {marqueeItems.map((item) => (
            <span class="flex items-center gap-10 whitespace-nowrap text-sm font-extrabold uppercase tracking-[0.28em] text-white/70">
              {item}
              <svg class="h-2.5 w-2.5 text-leaf-500" viewBox="0 0 10 10" fill="currentColor"><circle cx="5" cy="5" r="5" /></svg>
            </span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ===== Experience pillars ===== -->
  <section id="experience" class="section">
    <div class="shell-wide">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow">The experience</p>
        <h2 class="section-title">One visit, three kinds of care</h2>
        <p class="section-copy">
          Every plan is built around the patient in front of us. Whether you come in for correction, ongoing
          wellness, or your family, the visit is designed to feel clear, calm, and personal.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {pillars.map((pillar, index) => (
          <figure class="pillar-card group" data-reveal style={`--reveal-delay: ${index * 110}ms`}>
            <img src={asset(pillar.image)} alt={pillar.title} loading="lazy" />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-950/85 via-brand-950/15 to-transparent"></div>
            <figcaption class="absolute inset-x-0 bottom-0 p-7">
              <p class="text-[0.65rem] font-extrabold uppercase tracking-[0.3em] text-leaf-400">0{index + 1}</p>
              <h3 class="display mt-2 text-2xl text-white">{pillar.title}</h3>
              <p class="mt-2 text-sm leading-6 text-white/75">{pillar.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Services ===== -->
  <section id="services" class="section bg-white">
    <div class="shell-wide grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <p class="eyebrow">Services</p>
        <h2 class="section-title">Chiropractic care can help</h2>
        <p class="section-copy">
          Eight focused services, one goal: helping you move and feel better for the long run. Explore each one to
          see how it works and who it helps.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={contact.schedulingLink} target="_blank" rel="noreferrer" class="button button-primary">
            Book a visit
          </a>
          <a href="#contact" class="button button-ghost">Ask a question</a>
        </div>
      </div>

      <div>
        {services.map((service, index) => (
          <a
            href={`${base}services/${service.slug}/`}
            class="service-row group"
            data-reveal
            style={`--reveal-delay: ${(index % 4) * 70}ms`}
          >
            <span class="display text-lg text-brand-300 transition group-hover:text-leaf-600 sm:text-xl">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="flex-1">
              <span class="display block text-2xl text-brand-950 transition group-hover:text-brand-700 sm:text-3xl">
                {service.title}
              </span>
              <span class="mt-1.5 block text-sm leading-6 text-brand-800/65 sm:text-base">{service.description}</span>
            </span>
            <svg
              class="h-5 w-5 shrink-0 self-center text-brand-300 transition duration-300 group-hover:-rotate-45 group-hover:text-leaf-600"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 10h12m0 0l-5-5m5 5l-5 5" />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Meet the doctor ===== -->
  <section id="doctor" class="section">
    <div class="shell-wide grid items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div class="relative mx-auto w-full max-w-md" data-reveal>
        <div class="absolute -left-6 -top-6 h-40 w-40 rounded-[2.5rem] bg-leaf-300/50"></div>
        <div class="absolute -bottom-8 -right-6 h-48 w-48 rounded-full bg-mint-300/40"></div>
        <img
          src={asset('/images/doctor-portrait.jpg')}
          alt="Dr. James Yonushonis, chiropractor at Healthy Valley Chiropractic"
          class="relative w-full rounded-[2.5rem] object-cover shadow-[0_30px_80px_rgba(17,31,48,0.22)]"
          loading="lazy"
        />
        <div class="absolute -bottom-5 left-6 rounded-2xl bg-white px-5 py-3.5 shadow-[0_18px_44px_rgba(17,31,48,0.16)]">
          <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.28em] text-brand-500">Healthy Valley</p>
          <p class="display mt-0.5 text-lg text-brand-950">Dr. James Yonushonis</p>
        </div>
      </div>

      <div data-reveal style="--reveal-delay: 120ms">
        <p class="eyebrow">Meet the doctor</p>
        <h2 class="section-title">Dr. James Yonushonis</h2>
        <p class="section-copy">
          A Philipsburg, PA native and former captain of the Penn State wrestling team, Dr. James focuses on
          finding and addressing the root cause of your problem — not just treating symptoms — and educates you on
          how your body works.
        </p>
        <p class="section-copy !mt-4">
          Every visit starts with listening. You'll always understand what's happening, why it matters, and what
          comes next — whether you're a kid, an athlete, an expecting mother, or simply want to stay active and
          well.
        </p>

        <blockquote class="mt-10 border-l-2 border-leaf-500 pl-6">
          <p class="display text-xl leading-relaxed text-brand-900 sm:text-2xl">“{quote.text}”</p>
          <cite class="mt-3 block text-xs font-extrabold uppercase tracking-[0.3em] text-brand-500 not-italic">
            — {quote.author}
          </cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ===== Your first visit ===== -->
  <section class="section bg-white">
    <div class="shell-wide">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow">Your first visit</p>
        <h2 class="section-title">A simpler way to get started</h2>
      </div>

      <div class="relative mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        <div class="absolute left-0 right-0 top-6 hidden h-px bg-brand-900/10 md:block" aria-hidden="true"></div>
        {visitSteps.map((step, index) => (
          <div class="relative" data-reveal style={`--reveal-delay: ${index * 120}ms`}>
            <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full bg-brand-950 text-sm font-extrabold text-leaf-400 ring-8 ring-white">
              0{index + 1}
            </div>
            <h3 class="display mt-6 text-2xl text-brand-950">{step.title}</h3>
            <p class="mt-3 max-w-sm text-base leading-7 text-brand-800/70">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Testimonials ===== -->
  <section id="testimonials" class="section">
    <div class="shell-wide">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow">Testimonials</p>
          <h2 class="section-title">What patients say</h2>
          <a
            href={reviewStats.href}
            target="_blank"
            rel="noreferrer"
            class="mt-5 inline-flex items-center gap-3 rounded-full border border-brand-900/10 bg-white px-5 py-2.5 shadow-[0_10px_26px_rgba(17,31,48,0.08)] transition hover:border-brand-900/30"
          >
            <span class="flex text-leaf-500" aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => (
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.29 3.95a1 1 0 00.95.7h4.16c.97 0 1.37 1.24.59 1.81l-3.37 2.44a1 1 0 00-.36 1.12l1.28 3.95c.3.92-.75 1.69-1.54 1.12l-3.36-2.44a1 1 0 00-1.18 0l-3.36 2.44c-.79.57-1.84-.2-1.54-1.12l1.28-3.95a1 1 0 00-.36-1.12L2.06 9.39c-.78-.57-.38-1.8.59-1.8H6.8a1 1 0 00.95-.7l1.29-3.96z"/></svg>
              ))}
            </span>
            <span class="text-sm font-extrabold text-brand-950">{reviewStats.rating}</span>
            <span class="text-sm font-semibold text-brand-800/60">· {reviewStats.count} {reviewStats.source}</span>
          </a>
        </div>
        <div class="flex items-center gap-3">
          <a href={contact.mapsLink} target="_blank" rel="noreferrer" class="button button-ghost hidden w-fit sm:inline-flex">
            Leave a review
          </a>
          <button id="t-prev" class="carousel-btn" aria-label="Previous testimonials">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.5 15l-5-5 5-5" /></svg>
          </button>
          <button id="t-next" class="carousel-btn" aria-label="Next testimonials">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 5l5 5-5 5" /></svg>
          </button>
        </div>
      </div>

      <div id="t-track" class="carousel-track mt-10" data-reveal aria-label="Patient reviews carousel">
        {testimonials.map((item) => (
          <figure class="carousel-slide quote-card">
            <div class="flex items-center justify-between">
              <svg class="h-8 w-8 text-leaf-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.5 11c-.4 0-.8.05-1.2.13C5.9 8.9 7.6 7.2 9.6 6.6l-.7-1.8C5.7 5.9 3.5 8.9 3.5 12.5c0 3 1.7 5 4 5a3.25 3.25 0 100-6.5zm10 0c-.4 0-.8.05-1.2.13.6-2.23 2.3-3.93 4.3-4.53l-.7-1.8c-3.2 1.1-5.4 4.1-5.4 7.7 0 3 1.7 5 4 5a3.25 3.25 0 100-6.5z" />
              </svg>
              <span class="flex text-leaf-500" aria-label="5 star review">
                {[0, 1, 2, 3, 4].map(() => (
                  <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.29 3.95a1 1 0 00.95.7h4.16c.97 0 1.37 1.24.59 1.81l-3.37 2.44a1 1 0 00-.36 1.12l1.28 3.95c.3.92-.75 1.69-1.54 1.12l-3.36-2.44a1 1 0 00-1.18 0l-3.36 2.44c-.79.57-1.84-.2-1.54-1.12l1.28-3.95a1 1 0 00-.36-1.12L2.06 9.39c-.78-.57-.38-1.8.59-1.8H6.8a1 1 0 00.95-.7l1.29-3.96z"/></svg>
                ))}
              </span>
            </div>
            <blockquote class="mt-5 flex-1 text-base leading-8 text-brand-900/85">
              {item.quote}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-100 text-brand-700">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a4 4 0 100 8 4 4 0 000-8zM3 18a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
              </span>
              <span>
                <span class="block text-sm font-extrabold uppercase tracking-[0.16em] text-brand-700">{item.author}</span>
                <span class="block text-xs font-semibold text-brand-800/55">{item.source}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Inside the practice ===== -->
  <section class="section bg-white">
    <div class="shell-wide">
      <div class="max-w-3xl" data-reveal>
        <p class="eyebrow">Inside the practice</p>
        <h2 class="section-title">Real people, real care</h2>
        <p class="section-copy">
          A look at life at Healthy Valley Chiropractic — in the treatment room and out in the community.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:auto-rows-[16rem]">
        {galleryItems.map((item, index) => (
          <figure
            class={`group relative min-h-[18rem] overflow-hidden rounded-[2rem] shadow-[0_20px_50px_rgba(17,31,48,0.12)] ${item.span}`}
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <img
              src={asset(item.image)}
              alt={item.title}
              class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-950/80 via-brand-950/10 to-transparent"></div>
            <figcaption class="absolute inset-x-0 bottom-0 p-6">
              <h3 class="display text-xl text-white">{item.title}</h3>
              <p class="mt-1 text-sm text-white/75">{item.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Welcome band ===== -->
  <section
    class="parallax-band relative"
    style={`background-image: url('${asset('/images/community-honor.jpg')}')`}
  >
    <div class="absolute inset-0 bg-brand-950/68"></div>
    <div class="shell relative z-10 py-28 text-center sm:py-36">
      <p class="eyebrow eyebrow-light justify-center" data-reveal>From the moment you walk in</p>
      <h2 class="display mx-auto mt-5 max-w-3xl text-4xl leading-[1.08] text-white sm:text-5xl" data-reveal style="--reveal-delay: 100ms">
        You're welcomed like a neighbor, treated like family
      </h2>
      <div class="mt-9 flex flex-wrap justify-center gap-3" data-reveal style="--reveal-delay: 200ms">
        <a href={`${base}special/`} class="button button-accent">New patient special offer</a>
        <a href={contact.phoneHref} class="button button-ghost-dark">Call {contact.phone}</a>
      </div>
    </div>
  </section>

  <!-- ===== Hours & contact ===== -->
  <section id="contact" class="section">
    <div class="shell-wide grid gap-6 lg:grid-cols-[1fr_1.15fr]">
      <div id="hours" class="rounded-[2.25rem] bg-brand-950 p-8 text-white shadow-[0_30px_70px_rgba(17,31,48,0.3)] sm:p-10" data-reveal>
        <p class="eyebrow eyebrow-light">Office hours</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">Plan your visit</h2>
        <div class="mt-8">
          {officeHours.map((row) => (
            <div class="hour-row" data-day={row.day}>
              <p class="flex items-center gap-3 text-sm font-extrabold uppercase tracking-[0.24em] text-white/85">
                <span class="today-dot hidden h-2 w-2 rounded-full bg-leaf-400" aria-hidden="true"></span>
                {row.day}
              </p>
              <div class="text-right text-sm leading-6 text-white/65">
                {row.hours.map((hour) => (
                  <p>{hour}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
        <p class="mt-8 text-xs leading-6 text-white/45">
          <span class="inline-block h-2 w-2 rounded-full bg-leaf-400 align-middle"></span>
          <span class="ml-2 align-middle">Today's hours are highlighted.</span>
        </p>
      </div>

      <div class="flex flex-col gap-6">
        <div class="rounded-[2.25rem] border border-brand-900/8 bg-white p-8 shadow-[0_20px_50px_rgba(17,31,48,0.08)] sm:p-10" data-reveal style="--reveal-delay: 100ms">
          <p class="eyebrow">Contact</p>
          <h2 class="display mt-4 text-3xl text-brand-950 sm:text-4xl">Come say hello</h2>
          <div class="mt-7 grid gap-4 sm:grid-cols-2">
            <a href={contact.phoneHref} class="group rounded-2xl bg-brand-50 p-5 hover:bg-brand-100">
              <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.28em] text-brand-500">Phone</p>
              <p class="mt-1.5 text-lg font-extrabold text-brand-950 group-hover:text-brand-700">{contact.phone}</p>
            </a>
            <a href={contact.mapsLink} target="_blank" rel="noreferrer" class="group rounded-2xl bg-brand-50 p-5 hover:bg-brand-100">
              <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.28em] text-brand-500">Address</p>
              <p class="mt-1.5 text-base font-extrabold leading-6 text-brand-950 group-hover:text-brand-700">
                {contact.addressLine1}
                <br />
                {contact.addressLine2}
              </p>
            </a>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={contact.schedulingLink} target="_blank" rel="noreferrer" class="button button-primary">
              Patient portal
            </a>
            <a href={contact.mapsLink} target="_blank" rel="noreferrer" class="button button-ghost">
              Get directions
            </a>
          </div>
        </div>

        <div class="overflow-hidden rounded-[2.25rem] border border-brand-900/8 bg-white shadow-[0_20px_50px_rgba(17,31,48,0.08)]" data-reveal style="--reveal-delay: 180ms">
          <iframe
            title="Healthy Valley Chiropractic on Google Maps"
            src={contact.mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-64 w-full border-0 sm:h-72"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />

  <script>
    // Testimonials carousel: arrows + gentle autoplay (respects reduced motion)
    const track = document.getElementById('t-track');
    const prevBtn = document.getElementById('t-prev');
    const nextBtn = document.getElementById('t-next');
    if (track) {
      const step = () => {
        const slide = track.querySelector('.carousel-slide');
        return slide ? slide.getBoundingClientRect().width + 20 : 400;
      };
      const scrollNext = () => {
        const max = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft >= max - 10) track.scrollTo({ left: 0, behavior: 'smooth' });
        else track.scrollBy({ left: step(), behavior: 'smooth' });
      };
      const scrollPrev = () => {
        if (track.scrollLeft <= 10) track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
        else track.scrollBy({ left: -step(), behavior: 'smooth' });
      };
      nextBtn?.addEventListener('click', scrollNext);
      prevBtn?.addEventListener('click', scrollPrev);

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let timer: ReturnType<typeof setInterval> | undefined;
        const play = () => {
          stop();
          timer = setInterval(scrollNext, 5000);
        };
        const stop = () => {
          if (timer) clearInterval(timer);
        };
        ['mouseenter', 'touchstart', 'focusin', 'pointerdown'].forEach((event) =>
          track.addEventListener(event, stop, { passive: true })
        );
        ['mouseleave', 'focusout'].forEach((event) => track.addEventListener(event, play));
        play();
      }
    }
  </script>
</BaseLayout>
