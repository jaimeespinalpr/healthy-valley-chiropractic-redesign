---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact, officeHours, visitSteps } from '../data/site';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<BaseLayout
  title="New Patient Special | Healthy Valley Chiropractic"
  description="New patients are always welcome at Healthy Valley Chiropractic in State College, PA. Call the office to hear the details of the current new patient special offer."
>
  <!-- ===== Page hero ===== -->
  <section class="relative overflow-hidden pb-16 pt-36 sm:pb-20 sm:pt-44">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[30rem] w-[30rem] rounded-full bg-leaf-100 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-40 top-40 h-[24rem] w-[24rem] rounded-full bg-mint-100 blur-3xl"></div>
    <div class="shell-wide relative">
      <nav class="text-xs font-extrabold uppercase tracking-[0.24em] text-brand-400" aria-label="Breadcrumb" data-reveal>
        <a href={base} class="hover:text-brand-700">Home</a>
        <span class="mx-2 text-brand-300">/</span>
        <span class="text-brand-700">New Patient Special</span>
      </nav>
      <h1 class="display mt-6 max-w-3xl text-5xl leading-[1.04] text-brand-950 sm:text-6xl" data-reveal style="--reveal-delay: 80ms">
        Your first visit, made easy
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-brand-800/80" data-reveal style="--reveal-delay: 160ms">
        New patients are always welcome at Healthy Valley Chiropractic — and the office regularly runs a special
        offer to make getting started simple. Call today to hear the details of the current offer and reserve your
        first visit.
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 240ms">
        <a href={contact.phoneHref} class="button button-accent">Call {contact.phone}</a>
        <a href={contact.schedulingLink} target="_blank" rel="noreferrer" class="button button-primary">
          Schedule online
        </a>
      </div>
    </div>
  </section>

  <!-- ===== What to expect ===== -->
  <section class="section bg-white !pt-16">
    <div class="shell-wide grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
      <div data-reveal>
        <p class="eyebrow">What to expect</p>
        <h2 class="section-title">Three simple steps</h2>
        <div class="mt-10 space-y-8">
          {visitSteps.map((step, index) => (
            <div class="flex gap-5">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-950 text-sm font-extrabold text-leaf-400">
                0{index + 1}
              </div>
              <div>
                <h3 class="display text-2xl text-brand-950">{step.title}</h3>
                <p class="mt-2 max-w-md text-base leading-7 text-brand-800/70">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <figure class="overflow-hidden rounded-[2.5rem] shadow-[0_30px_80px_rgba(17,31,48,0.18)]" data-reveal style="--reveal-delay: 120ms">
        <img
          src={asset('/images/front-desk-welcome.jpg')}
          alt="A warm welcome at the Healthy Valley Chiropractic front desk"
          class="h-full min-h-[22rem] w-full object-cover object-right"
        />
      </figure>
    </div>
  </section>

  <!-- ===== Hours + CTA ===== -->
  <section class="section">
    <div class="shell-wide grid gap-6 lg:grid-cols-2">
      <div class="rounded-[2.25rem] bg-brand-950 p-8 text-white shadow-[0_30px_70px_rgba(17,31,48,0.3)] sm:p-10" data-reveal>
        <p class="eyebrow eyebrow-light">Office hours</p>
        <h2 class="display mt-4 text-3xl sm:text-4xl">When to find us</h2>
        <div class="mt-8">
          {officeHours.map((row) => (
            <div class="hour-row" data-day={row.day}>
              <p class="flex items-center gap-3 text-sm font-extrabold uppercase tracking-[0.24em] text-white/85">
                <span class="today-dot hidden h-2 w-2 rounded-full bg-leaf-400" aria-hidden="true"></span>
                {row.day}
              </p>
              <div class="text-right text-sm leading-6 text-white/65">
                {row.hours.map((hour) => (
                  <p>{hour}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="flex flex-col justify-center rounded-[2.25rem] border border-brand-900/8 bg-white p-8 shadow-[0_20px_50px_rgba(17,31,48,0.08)] sm:p-10" data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow">Ready when you are</p>
        <h2 class="display mt-4 text-3xl text-brand-950 sm:text-4xl">Reserve your first visit</h2>
        <p class="mt-5 text-base leading-8 text-brand-800/75">
          The fastest way to get started is a quick phone call — the team will explain the current new patient
          special, answer your questions, and find a time that works for you.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <a href={contact.phoneHref} class="group rounded-2xl bg-brand-50 p-5 hover:bg-brand-100">
            <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.28em] text-brand-500">Phone</p>
            <p class="mt-1.5 text-lg font-extrabold text-brand-950 group-hover:text-brand-700">{contact.phone}</p>
          </a>
          <a href={contact.mapsLink} target="_blank" rel="noreferrer" class="group rounded-2xl bg-brand-50 p-5 hover:bg-brand-100">
            <p class="text-[0.62rem] font-extrabold uppercase tracking-[0.28em] text-brand-500">Address</p>
            <p class="mt-1.5 text-base font-extrabold leading-6 text-brand-950 group-hover:text-brand-700">
              {contact.addressLine1}
              <br />
              {contact.addressLine2}
            </p>
          </a>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={contact.schedulingLink} target="_blank" rel="noreferrer" class="button button-primary">
            Patient portal
          </a>
          <a href={`${base}#services`} class="button button-ghost">Explore services</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
