---
import { contact, legalPages, navLinks, services, socialLinks } from '../data/site';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<footer class="bg-brand-950 pb-10 pt-16 text-white">
  <div class="shell-wide">
    <div class="flex flex-col gap-10 border-b border-white/10 pb-10 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-sm">
        <img src={asset('/images/logo.png')} alt="Healthy Valley Chiropractic" class="h-14 w-auto" loading="lazy" />
        <p class="mt-5 text-sm leading-7 text-white/55">
          {contact.addressLine1}, {contact.addressLine2}
          <br />
          <a href={contact.phoneHref} class="font-bold text-white/80 hover:text-white">{contact.phone}</a>
        </p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="rounded-full border border-white/15 px-4 py-2 text-xs font-extrabold uppercase tracking-[0.2em] text-white/65 hover:border-white/40 hover:text-white"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="grid flex-1 gap-10 sm:grid-cols-3 lg:max-w-3xl">
        <nav aria-label="Site sections">
          <p class="text-xs font-extrabold uppercase tracking-[0.3em] text-white/40">Explore</p>
          <div class="mt-5 flex flex-col gap-3">
            {navLinks.map((link) => (
              <a href={`${base}#${link.anchor}`} class="footer-link">{link.label}</a>
            ))}
            <a href={`${base}special/`} class="footer-link">New Patient Special</a>
          </div>
        </nav>
        <nav aria-label="Services">
          <p class="text-xs font-extrabold uppercase tracking-[0.3em] text-white/40">Services</p>
          <div class="mt-5 flex flex-col gap-3">
            {services.map((service) => (
              <a href={`${base}services/${service.slug}/`} class="footer-link">{service.title}</a>
            ))}
          </div>
        </nav>
        <nav aria-label="Policies and legal">
          <p class="text-xs font-extrabold uppercase tracking-[0.3em] text-white/40">Policies</p>
          <div class="mt-5 flex flex-col gap-3">
            {legalPages.map((page) => (
              <a href={`${base}legal/${page.slug}/`} class="footer-link">{page.title}</a>
            ))}
          </div>
        </nav>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 pt-8 text-xs text-white/40 sm:flex-row">
      <p>© {new Date().getFullYear()} Healthy Valley Chiropractic. All rights reserved.</p>
      <p>State College, Pennsylvania</p>
    </div>
  </div>
</footer>
