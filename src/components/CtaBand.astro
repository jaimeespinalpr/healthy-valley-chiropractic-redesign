---
import { contact } from '../data/site';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;

const {
  heading = 'Ready to feel like yourself again?',
  copy = 'New patients are always welcome. Take advantage of the new patient special and see what personal chiropractic care feels like.',
} = Astro.props;
---

<section class="pb-20 pt-4 sm:pb-24">
  <div class="shell-wide">
    <div
      class="relative overflow-hidden rounded-[2.5rem] bg-brand-950 px-8 py-16 text-center shadow-[0_36px_90px_rgba(17,31,48,0.35)] sm:px-16 sm:py-20"
      data-reveal
    >
      <div class="pointer-events-none absolute -left-20 -top-24 h-72 w-72 rounded-full bg-leaf-500/12 blur-2xl"></div>
      <div class="pointer-events-none absolute -bottom-28 -right-16 h-80 w-80 rounded-full bg-mint-500/12 blur-2xl"></div>
      <img src={asset('/images/logo.png')} alt="" aria-hidden="true" class="mx-auto h-16 w-auto" loading="lazy" />
      <h2 class="display mx-auto mt-7 max-w-2xl text-4xl leading-[1.06] text-white sm:text-5xl">{heading}</h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-white/65">{copy}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={`${base}special/`} class="button button-accent">New patient special offer</a>
        <a href={contact.schedulingLink} target="_blank" rel="noreferrer" class="button button-ghost-dark">
          Schedule online
        </a>
      </div>
    </div>
  </div>
</section>
